<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="parallelbrowsers" parallel="methods" thread-count="20">
    <listeners>
        <listener class-name="base.Listeners"/>
    </listeners>
    <!--    name of the test suite that have multiple test folders (test names)-->
    <!-- <parameter name="URL" value="https://www.rahulshettyacademy.com"/> -->
    <!-- <listeners>
         <listener class-name="test.Listeners"/>
     </listeners> -->




    <!-- <test name="submit Tests">
        <classes>
            <class name="tests.SubmitOrder"/>
        </classes>
    </test> -->

    <test name="tests on chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.ErrorValidation">
                <methods>
                    <exclude name="orderIdValidation"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="tests on edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="tests.ErrorValidation">
                <methods>
                    <exclude name="orderIdValidation"/>
                </methods>
            </class>
        </classes>
    </test>


